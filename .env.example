# MoMo Payment Gateway Configuration - Example Environment Variables
# Copy this file to .env and fill in your actual MoMo Sandbox credentials from https://dev.momo.vn

# ===== MoMo Sandbox Credentials =====
# Obtain these from MoMo Developer Portal: https://dev.momo.vn/dashboard

# Your MoMo Partner Code (Mã đối tác)
MOMO_PARTNER_CODE=MOMO12345

# MoMo Access Key (Khóa truy cập)
MOMO_ACCESS_KEY=F8635FE50A0FE6588

# MoMo Secret Key (Khóa bí mật) - KEEP THIS SECURE!
MOMO_SECRET_KEY=NFcpIQIChnh0szvg6Z9zesZDZURAVESz

# ===== MoMo Endpoints =====
# Sandbox endpoint for testing
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# Production endpoint (use only when ready for production)
# MOMO_ENDPOINT=https://payment.momo.vn/v2/gateway/api/create

# ===== Redirect and Callback URLs =====
# Frontend success page - where customer is redirected after payment
MOMO_REDIRECT_URL=http://localhost:3000/payment-success

# Backend webhook URL - where MoMo sends IPN callbacks
# For development: use ngrok or tunneling service to expose localhost
# For production: use your actual backend domain
MOMO_IPN_URL=http://localhost:8080/api/v1/callback/momo/ipn

# ===== Optional =====
# Request type - always "captureWallet" for standard payments
MOMO_REQUEST_TYPE=captureWallet

# Language for MoMo UI - "vi" for Vietnamese, "en" for English
MOMO_LANG=vi
