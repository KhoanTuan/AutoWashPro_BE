# Sao chép thành application-local.yaml (đã gitignore)

app:
  mail:
    mode: GMAIL
    # MOCK = in link ra console + trả devActionUrl | GMAIL = gửi email Thymeleaf thật
  gmail:
    username: your.email@gmail.com
    app-password: YOUR_GMAIL_APP_PASSWORD
    from-name: AutoWash Pro
  speedsms:
    enabled: false
    access-token: your_speedsms_api_access_token
    sender: ""

spring:
  mail:
    username: your.email@gmail.com
    password: YOUR_GMAIL_APP_PASSWORD
    properties:
      mail:
        debug: true
        smtp:
          ssl:
            trust: smtp.gmail.com
